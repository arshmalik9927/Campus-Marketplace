<% layout("layouts/boilerplate") -%>

<div class="container">

    <!-- Hero -->
    <section class="hero">

        <div class="hero-copy">

            <p class="eyebrow">
                THE MARKETPLACE MADE FOR STUDENTS
            </p>

            <h1>
                Buy smart.
                <span>Sell easy.</span>
                Stay connected.
            </h1>

            <p class="hero-text">
                Find affordable books, notes, calculators, laptops
                and everything else you need for college.
            </p>

            <div class="hero-actions">

                <a
                    href="#products"
                    class="btn-primary"
                >
                    Start browsing
                </a>

                <a
                    href="#how-it-works"
                    class="btn-secondary"
                >
                    See how it works
                </a>

            </div>

        </div>


        <!-- Hero Visual -->
        <div class="hero-visual">

            <div class="hero-product-card hero-card-one">

                <div class="hero-card-image">
                    🎧
                </div>

                <div class="hero-card-info">
                    <span>Electronics</span>
                    <strong>Marshall Speaker</strong>
                    <small>₹2,500</small>
                </div>

            </div>


            <div class="hero-product-card hero-card-two">

                <div class="hero-card-image">
                    👕
                </div>

                <div class="hero-card-info">
                    <span>Fashion</span>
                    <strong>Vintage Jacket</strong>
                    <small>₹900</small>
                </div>

            </div>


            <div class="hero-product-card hero-card-three">

                <div class="hero-card-image">
                    📚
                </div>

                <div class="hero-card-info">
                    <span>Academic</span>
                    <strong>Exam Notes</strong>
                    <small>₹120</small>
                </div>

            </div>

        </div>

    </section>


    <!-- Trending -->
    <section class="section-block">

        <div class="section-heading">

            <div>

                <p class="section-eyebrow">
                    TRENDING NOW
                </p>

                <h2>
                    Popular on campus
                </h2>

            </div>

            <a
                href="#products"
                class="section-link"
            >
                View all →
            </a>

        </div>


        <div class="listing-grid">

            <% if (allProduct && allProduct.length > 0) { %>

                <% allProduct.slice(0, 6).forEach(product => { %>

                    <a
                        href="/products/<%= product._id %>"
                        class="market-card fresh-photo"
                    >

                        <div class="market-image">

                            <% if (
                                product.image &&
                                product.image.url
                            ) { %>

                                <img
                                    src="<%= product.image.url %>"
                                    alt="<%= product.title %>"
                                >

                            <% } else { %>

                                <div class="no-image">
                                    No Image
                                </div>

                            <% } %>

                        </div>


                        <div class="market-info">

                            <p class="market-category">
                                <%= product.category %>
                            </p>

                            <h3>
                                <%= product.title %>
                            </h3>

                            <div class="market-bottom">

                                <strong>
                                    ₹<%= product.price.toLocaleString("en-IN") %>
                                </strong>

                                <span>
                                    View →
                                </span>

                            </div>

                        </div>

                    </a>

                <% }) %>

            <% } %>

        </div>

    </section>


    <!-- Categories -->
    <section class="section-block">

        <div class="section-heading">

            <div>

                <p class="section-eyebrow">
                    FIND YOUR THING
                </p>

                <h2>
                    Browse categories
                </h2>

            </div>

        </div>


        <div class="product-categories">

            <a
                href="/products"
                class="product-category active"
            >
                All items
            </a>

            <a
                href="/products/category/Notes"
                class="product-category"
            >
                Notes
            </a>

            <a
                href="/products/category/Books"
                class="product-category"
            >
                Books
            </a>

            <a
                href="/products/category/Calculators"
                class="product-category"
            >
                Calculators
            </a>

            <a
                href="/products/category/Laptops"
                class="product-category"
            >
                Laptops
            </a>

            <a
                href="/products/category/Accessories"
                class="product-category"
            >
                Accessories
            </a>

        </div>

    </section>


    <!-- All Products -->
    <section
        class="product-section"
        id="products"
    >

        <div class="products-header">

            <div>

                <p class="product-eyebrow">
                    CAMPUS MARKETPLACE
                </p>

                <h2 class="products-heading">
                    All Products
                </h2>

                <p class="products-subtitle">
                    Discover useful products listed by students.
                </p>

            </div>


            <!-- Search -->
            <form
                action="/products/search"
                method="GET"
                class="product-search"
            >

                <input
                    type="search"
                    name="search"
                    value="<%= typeof search !== 'undefined' ? search : '' %>"
                    placeholder="Search products..."
                    class="product-search-input"
                >

                <button
                    type="submit"
                    class="btn-primary product-search-btn"
                >
                    Search
                </button>

            </form>

        </div>


        <!-- Product Categories -->
        <div class="product-categories">

            <a
                href="/products"
                class="product-category"
            >
                All
            </a>

            <a
                href="/products/category/Notes"
                class="product-category"
            >
                Notes
            </a>

            <a
                href="/products/category/Books"
                class="product-category"
            >
                Books
            </a>

            <a
                href="/products/category/Calculators"
                class="product-category"
            >
                Calculators
            </a>

            <a
                href="/products/category/Laptops"
                class="product-category"
            >
                Laptops
            </a>

            <a
                href="/products/category/Accessories"
                class="product-category"
            >
                Accessories
            </a>

        </div>


        <!-- Products -->
        <div class="product-grid">

            <% if (allProduct && allProduct.length > 0) { %>

                <% allProduct.forEach(product => { %>

                    <article class="product-card">

                        <!-- Image -->
                        <a
                            href="/products/<%= product._id %>"
                            class="product-card-image-link"
                        >

                            <% if (
                                product.image &&
                                product.image.url
                            ) { %>

                                <img
                                    src="<%= product.image.url %>"
                                    alt="<%= product.title %>"
                                    class="product-card-image"
                                >

                            <% } else { %>

                                <div class="product-card-no-image">
                                    No Image
                                </div>

                            <% } %>

                        </a>


                        <!-- Content -->
                        <div class="product-card-content">

                            <p class="product-card-category">
                                <%= product.category %>
                            </p>


                            <h3 class="product-card-title">
                                <%= product.title %>
                            </h3>


                            <p class="product-card-description">
                                <%= product.description %>
                            </p>


                            <div class="product-card-bottom">

                                <strong class="product-card-price">
                                    ₹<%= product.price.toLocaleString("en-IN") %>
                                </strong>


                                <span class="product-card-seller">

                                    <% if (product.seller) { %>

                                        <%= product.seller.username %>

                                    <% } else { %>

                                        Campus Seller

                                    <% } %>

                                </span>

                            </div>

                        </div>

                    </article>

                <% }) %>


            <% } else { %>

                <div class="products-empty">

                    <h2 class="products-empty-title">
                        No products found
                    </h2>

                    <p class="products-empty-text">
                        Try another search or browse a different category.
                    </p>

                    <a
                        href="/products"
                        class="btn-primary"
                    >
                        View All Products
                    </a>

                </div>

            <% } %>

        </div>

    </section>


    <!-- How It Works -->
    <section
        class="how-it-works"
        id="how-it-works"
    >

        <div class="section-heading">

            <div>

                <p class="section-eyebrow">
                    SIMPLE & SAFE
                </p>

                <h2>
                    How CampusMarket works
                </h2>

            </div>

        </div>


        <div class="steps-grid">

            <div class="step-card">

                <span class="step-number">
                    01
                </span>

                <h3>
                    Find what you need
                </h3>

                <p>
                    Search through products listed by students
                    around your campus.
                </p>

            </div>


            <div class="step-card">

                <span class="step-number">
                    02
                </span>

                <h3>
                    Connect & buy
                </h3>

                <p>
                    Check the product details, seller information
                    and reviews before buying.
                </p>

            </div>


            <div class="step-card">

                <span class="step-number">
                    03
                </span>

                <h3>
                    Sell your stuff
                </h3>

                <p>
                    Have something useful? Create a listing and
                    connect with fellow students.
                </p>

            </div>

        </div>

    </section>

</div>