<% layout("layouts/boilerplate") -%>

<div class="container">

    <section class="product-form-section">

        <div class="product-form-header">
            <p class="product-eyebrow">MANAGE YOUR LISTING</p>

            <h1 class="product-form-title">
                Edit Product
            </h1>

            <p class="product-form-subtitle">
                Update your product information and keep your listing fresh.
            </p>
        </div>


        <div class="product-form-card">

            <form
                action="/products/<%= product._id %>?_method=PUT"
                method="POST"
                enctype="multipart/form-data"
                class="product-form"
            >

                <!-- Product Title -->
                <div class="product-form-group">

                    <label
                        for="title"
                        class="product-form-label"
                    >
                        Product Name
                    </label>

                    <input
                        type="text"
                        id="title"
                        name="product[title]"
                        value="<%= product.title %>"
                        required
                        class="product-form-input"
                    >

                </div>


                <!-- Category -->
                <div class="product-form-group">

                    <label
                        for="category"
                        class="product-form-label"
                    >
                        Category
                    </label>

                    <select
                        id="category"
                        name="product[category]"
                        required
                        class="product-form-select"
                    >

                        <option value="Notes" <%= product.category === "Notes" ? "selected" : "" %>>
                            Notes
                        </option>

                        <option value="Books" <%= product.category === "Books" ? "selected" : "" %>>
                            Books
                        </option>

                        <option value="Calculators" <%= product.category === "Calculators" ? "selected" : "" %>>
                            Calculators
                        </option>

                        <option value="Laptops" <%= product.category === "Laptops" ? "selected" : "" %>>
                            Laptops
                        </option>

                        <option value="Accessories" <%= product.category === "Accessories" ? "selected" : "" %>>
                            Accessories
                        </option>

                    </select>

                </div>


                <!-- Price -->
                <div class="product-form-group">

                    <label
                        for="price"
                        class="product-form-label"
                    >
                        Price
                    </label>

                    <div class="product-price-input">

                        <span>₹</span>

                        <input
                            type="number"
                            id="price"
                            name="product[price]"
                            value="<%= product.price %>"
                            min="0"
                            required
                            class="product-form-input"
                        >

                    </div>

                </div>


                <!-- Description -->
                <div class="product-form-group">

                    <label
                        for="description"
                        class="product-form-label"
                    >
                        Description
                    </label>

                    <textarea
                        id="description"
                        name="product[description]"
                        rows="6"
                        required
                        class="product-form-textarea"
                    ><%= product.description %></textarea>

                </div>


                <!-- Current Image -->
                <% if (product.image && product.image.url) { %>

                    <div class="product-current-image">

                        <p class="product-form-label">
                            Current Image
                        </p>

                        <img
                            src="<%= product.image.url %>"
                            alt="<%= product.title %>"
                            class="product-edit-image"
                        >

                    </div>

                <% } %>


                <!-- New Image -->
                <div class="product-form-group">

                    <label
                        for="image"
                        class="product-form-label"
                    >
                        Replace Image
                    </label>

                    <input
                        type="file"
                        id="image"
                        name="product[image]"
                        accept="image/*"
                        class="product-form-file"
                    >

                    <p class="product-form-help">
                        Leave this empty if you want to keep the current image.
                    </p>

                </div>


                <!-- Actions -->
                <div class="product-form-actions">

                    <button
                        type="submit"
                        class="btn-primary"
                    >
                        Save Changes
                    </button>

                    <a
                        href="/products/<%= product._id %>"
                        class="btn-secondary"
                    >
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </section>

</div>