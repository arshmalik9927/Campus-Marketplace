<% layout("layouts/boilerplate") -%>

<div class="container">

    <section class="product-form-section">

        <div class="product-form-header">
            <p class="product-eyebrow">SELL ON CAMPUSMARKET</p>

            <h1 class="product-form-title">
                List a Product
            </h1>

            <p class="product-form-subtitle">
                Add your product details and connect with fellow students.
            </p>
        </div>


        <div class="product-form-card">

            <form
                action="/products"
                method="POST"
                enctype="multipart/form-data"
                class="product-form"
            >

                <!-- Product Title -->
                <div class="product-form-group">

                    <label
                        for="title"
                        class="product-form-label"
                    >
                        Product Name
                    </label>

                    <input
                        type="text"
                        id="title"
                        name="product[title]"
                        placeholder="e.g. Engineering Mathematics Notes"
                        required
                        class="product-form-input"
                    >

                </div>


                <!-- Category -->
                <div class="product-form-group">

                    <label
                        for="category"
                        class="product-form-label"
                    >
                        Category
                    </label>

                    <select
                        id="category"
                        name="product[category]"
                        required
                        class="product-form-select"
                    >

                        <option value="">
                            Select a category
                        </option>

                        <option value="Notes">
                            Notes
                        </option>

                        <option value="Books">
                            Books
                        </option>

                        <option value="Calculators">
                            Calculators
                        </option>

                        <option value="Laptops">
                            Laptops
                        </option>

                        <option value="Accessories">
                            Accessories
                        </option>

                    </select>

                </div>


                <!-- Price -->
                <div class="product-form-group">

                    <label
                        for="price"
                        class="product-form-label"
                    >
                        Price
                    </label>

                    <div class="product-price-input">

                        <span>₹</span>

                        <input
                            type="number"
                            id="price"
                            name="product[price]"
                            placeholder="Enter price"
                            min="0"
                            required
                            class="product-form-input"
                        >

                    </div>

                </div>


                <!-- Description -->
                <div class="product-form-group">

                    <label
                        for="description"
                        class="product-form-label"
                    >
                        Description
                    </label>

                    <textarea
                        id="description"
                        name="product[description]"
                        rows="6"
                        placeholder="Describe your product, condition, useful details, etc."
                        required
                        class="product-form-textarea"
                    ></textarea>

                </div>


                <!-- Image -->
                <div class="product-form-group">

                    <label
                        for="image"
                        class="product-form-label"
                    >
                        Product Image
                    </label>

                    <input
                        type="file"
                        id="image"
                        name="product[image]"
                        accept="image/*"
                        required
                        class="product-form-file"
                    >

                    <p class="product-form-help">
                        Upload a clear image of your product.
                    </p>

                </div>


                <!-- Submit -->
                <div class="product-form-actions">

                    <button
                        type="submit"
                        class="btn-primary"
                    >
                        List Product
                    </button>

                    <a
                        href="/products"
                        class="btn-secondary"
                    >
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </section>

</div>