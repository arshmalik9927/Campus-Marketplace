<% layout("layouts/boilerplate") -%>

<div class="container">

    <section class="order-section">

        <!-- Header -->
        <div class="order-header">

            <p class="order-eyebrow">
                MY ACCOUNT
            </p>

            <h1 class="order-title">
                My Orders
            </h1>

            <p class="order-subtitle">
                View and track all the products you have ordered.
            </p>

        </div>


        <% if (orders && orders.length > 0) { %>

            <!-- Orders List -->
            <div class="orders-list">

                <% orders.forEach(order => { %>

                    <article class="order-list-card">

                        <!-- Order Header -->
                        <div class="order-list-header">

                            <div>

                                <p class="order-info-label">
                                    ORDER ID
                                </p>

                                <h2 class="order-list-id">
                                    #<%= order._id %>
                                </h2>

                            </div>


                            <span class="order-status">
                                <%= order.status %>
                            </span>

                        </div>


                        <!-- Order Details -->
                        <div class="order-list-details">

                            <div class="order-list-detail">

                                <span>
                                    Order Date
                                </span>

                                <strong>
                                    <%= new Date(order.createdAt).toLocaleDateString("en-IN") %>
                                </strong>

                            </div>


                            <div class="order-list-detail">

                                <span>
                                    Items
                                </span>

                                <strong>
                                    <%= order.items.length %>
                                </strong>

                            </div>


                            <div class="order-list-detail">

                                <span>
                                    Total
                                </span>

                                <strong>
                                    ₹<%= order.totalAmount.toLocaleString("en-IN") %>
                                </strong>

                            </div>

                        </div>


                        <!-- Product Preview -->
                        <div class="order-list-items">

                            <% order.items.slice(0, 3).forEach(item => { %>

                                <div class="order-list-item">

                                    <div class="order-list-item-info">

                                        <h3>
                                            <%= item.title %>
                                        </h3>

                                        <p>
                                            Qty: <%= item.quantity %>
                                        </p>

                                    </div>

                                    <strong>
                                        ₹<%= (
                                            item.price * item.quantity
                                        ).toLocaleString("en-IN") %>
                                    </strong>

                                </div>

                            <% }) %>


                            <% if (order.items.length > 3) { %>

                                <p class="order-more-items">
                                    + <%= order.items.length - 3 %> more item<%= order.items.length - 3 !== 1 ? "s" : "" %>
                                </p>

                            <% } %>

                        </div>


                        <!-- Footer -->
                        <div class="order-list-footer">

                            <span>
                                <%= order.status === "Completed"
                                    ? "Order completed"
                                    : "Order placed successfully" %>
                            </span>

                            <a
                                href="/orders/<%= order._id %>"
                                class="btn-secondary"
                            >
                                View Details →
                            </a>

                        </div>

                    </article>

                <% }) %>

            </div>


        <% } else { %>

            <!-- Empty Orders -->
            <div class="orders-empty">

                <div class="orders-empty-icon">
                    📦
                </div>

                <h2>
                    No Orders Yet
                </h2>

                <p>
                    You haven't placed any orders yet.
                    Start browsing products and find something you need.
                </p>

                <a
                    href="/products"
                    class="btn-primary"
                >
                    Browse Products
                </a>

            </div>

        <% } %>


        <!-- Bottom Action -->
        <div class="order-bottom-action">

            <a
                href="/products"
                class="btn-secondary"
            >
                ← Continue Shopping
            </a>

        </div>

    </section>

</div>